# Copy to backend/.env and fill in your database connection string.
# Postgres example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clearbench
DATABASE_URL=sqlite:///./clearbench.db
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false        # local http only; leave unset in production
# DEMO_PASSWORD=clearbench-demo   # optional; must match src/constants/demoAccounts.ts