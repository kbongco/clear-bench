# Copy to backend/.env and fill in your values.
# Never put real secrets in this file: it's committed to the repo.

# Database — SQLite is the quickest for local dev:
DATABASE_URL=sqlite:///./clearbench.db
# Or Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clearbench

# Signs login tokens. Use any long random string locally, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Local dev runs on http, so the login cookie can't require https.
# Leave this unset in production.
COOKIE_SECURE=false

# Optional: the demo accounts' password. Must match src/constants/demoAccounts.ts.
# DEMO_PASSWORD=clearbench-demo